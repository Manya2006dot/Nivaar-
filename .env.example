# =============================================================================
# NIVAAR — Environment Variables
# Copy this file to .env.local for local dev. Never commit the real .env.local.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# From: Supabase Dashboard -> Project Settings -> API
# Safe to expose in the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Server-only. Never prefix with NEXT_PUBLIC_. Used only inside
# API routes (src/app/api/**) to perform privileged operations (e.g. reading
# across all users' reports for the admin dashboard's server checks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI vision + report generation ------------------------------------------
# From: https://platform.openai.com/api-keys
# SECRET. Server-only. Used in src/app/api/ai/classify and /compose.
# Uses OpenAI's gpt-4o (vision + chat). You can reuse the same key as
# STT_API_KEY below — if AI_API_KEY is left blank, provider.ts falls back to
# STT_API_KEY automatically, so one OpenAI key covers everything.
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o

# --- Speech-to-text (voice notes) -------------------------------------------
# From: https://platform.openai.com/api-keys — can be the exact same key as
# AI_API_KEY above.
# SECRET. Server-only. Used in src/app/api/ai/transcribe (Whisper).
STT_API_KEY=your-openai-api-key

# --- Maps (optional) ---------------------------------------------------------
# Leave blank to use the free OpenStreetMap-based map (no key required).
# If set, the app switches to real Google Maps automatically.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Admin access ------------------------------------------------------------
# Temporary, simple gate for /admin until you wire up a real role system.
# See README "Upgrading admin auth" for the production-grade approach
# (Supabase `profiles.is_admin` + real login).
ADMIN_ACCESS_CODE=change-me-to-something-only-you-know
